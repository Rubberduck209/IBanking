# Copy file này thành ".env" và điền giá trị thật, KHÔNG commit file .env lên git

# --- Database ---
DB_HOST=mysql_db
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=payment_DB

# --- JWT ---
# Sinh chuỗi random bằng: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Các service khác
USER_SERVICE_URL=http://user_service:8000
TUITION_SERVICE_URL=http://tuition_service:8000

# Mail
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=replace_with_an_app_password
